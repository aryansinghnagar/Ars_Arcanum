/**
 * Grimoire Rofi Theme — Ars Arcanum Workflow Launcher
 */

* {
    background:                  #1a1a2e;
    background-alt:              #22223a;
    foreground:                  #f5e6c8;
    selected:                    #c9a96e;
    active:                      #4a1942;
    urgent:                      #8b0000;
    border-color:                #c9a96e;

    font:                        "Cinzel 11";
}

window {
    background-color:            @background;
    border:                      2px solid;
    border-color:                @border-color;
    border-radius:               6px;
    width:                       650px;
    padding:                     15px;
}

mainbox {
    children:                    [ inputbar, listview ];
    spacing:                     12px;
}

inputbar {
    children:                    [ prompt, entry ];
    background-color:            @background-alt;
    border-radius:               4px;
    padding:                     8px;
}

prompt {
    text-color:                  @selected;
    font:                        "Cinzel Bold 11";
}

entry {
    text-color:                  @foreground;
    placeholder:                 "Search creative tools & workflow arcs...";
    placeholder-color:           #8a7e6b;
}

listview {
    lines:                       8;
    columns:                     1;
    spacing:                     4px;
}

element {
    padding:                     8px;
    border-radius:               4px;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  #1a1a2e;
    font-weight:                 bold;
}
