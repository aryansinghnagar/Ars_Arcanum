[global]
    font = EB Garamond 11
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "320x6-20+45"
    transparency = 10
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    separator_color = frame
    frame_width = 2
    frame_color = "#c9a96e"

[urgency_low]
    background = "#1a1a2e"
    foreground = "#f5e6c8"
    timeout = 4

[urgency_normal]
    background = "#1a1a2e"
    foreground = "#f5e6c8"
    timeout = 6

[urgency_critical]
    background = "#4a1942"
    foreground = "#f5e6c8"
    frame_color = "#e63946"
    timeout = 0
