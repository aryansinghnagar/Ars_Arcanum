#!/bin/sh
# 03-flatpak-isolated-apps.hook.chroot — Sandboxed Flatpak Applications

set -e
echo "[*] Configuring Sandboxed Flatpak Runtimes & Isolated Applications..."

if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
  
  # Install Obsidian with enforced network denial
  flatpak install -y flathub md.obsidian.Obsidian || true
  flatpak override --nosocket=network md.obsidian.Obsidian || true

  # Install Blanket ambient player with network denial
  flatpak install -y flathub com.rafaelmardojai.Blanket || true
  flatpak override --nosocket=network com.rafaelmardojai.Blanket || true

  # Install draw.io Desktop
  flatpak install -y flathub com.jgraph.drawio.desktop || true
  flatpak override --nosocket=network com.jgraph.drawio.desktop || true
fi

echo "[+] Flatpak isolated applications configured."
