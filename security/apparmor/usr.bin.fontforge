# AppArmor profile for FontForge in Ars Arcanum

abi <abi/3.0>,
include <tunables/global>

profile fontforge /usr/bin/fontforge {
  include <abstractions/base>
  include <abstractions/fonts>
  include <abstractions/X>
  include <abstractions/freedesktop.org>

  deny network inet,
  deny network inet6,

  owner @{HOME}/Worlds/** rwkl,
  owner @{HOME}/.FontForge/** rwkl,
  owner @{HOME}/.local/share/fonts/** rwkl,
  /tmp/** rwkl,

  deny @{HOME}/.ssh/** rwklx,
  deny @{HOME}/.gnupg/** rwklx,
}
