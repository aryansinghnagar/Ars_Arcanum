# AppArmor profile for PolyGlot in Ars Arcanum

abi <abi/3.0>,
include <tunables/global>

profile polyglot /usr/bin/polyglot /usr/local/bin/polyglot {
  include <abstractions/base>
  include <abstractions/fonts>
  include <abstractions/X>
  include <abstractions/freedesktop.org>

  deny network inet,
  deny network inet6,

  owner @{HOME}/Worlds/** rwkl,
  owner @{HOME}/.PolyGlot/** rwkl,
  /tmp/** rwkl,

  deny @{HOME}/.ssh/** rwklx,
  deny @{HOME}/.gnupg/** rwklx,
}
