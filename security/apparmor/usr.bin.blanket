# AppArmor profile for Blanket in Ars Arcanum
# Applies to native .deb installs. Flatpak installs
# (com.rafaelmardojai.Blanket) are confined via
# `flatpak override --nosocket=network` (see 03-flatpak-isolated-apps hook).

abi <abi/3.0>,
include <tunables/global>

profile blanket /usr/bin/blanket {
  include <abstractions/base>
  include <abstractions/fonts>
  include <abstractions/audio>
  include <abstractions/X>
  include <abstractions/freedesktop.org>

  deny network inet,
  deny network inet6,

  owner @{HOME}/.config/blanket/** rwkl,
  owner @{HOME}/.local/share/blanket/** rwkl,
  /tmp/** rwkl,

  deny @{HOME}/.ssh/** rwklx,
  deny @{HOME}/.gnupg/** rwklx,
}
